PORT=3000
HOST=0.0.0.0
ENV=development

# Persistence: leave DATABASE_URL empty to use embedded SQLite (WAL mode).
# Set DATABASE_URL=postgresql://user:pass@host:5432/db to use PostgreSQL FOR UPDATE SKIP LOCKED.
SQLITE_PATH=./data/webhooks.db
DATABASE_URL=

# Worker & Retry Settings
WORKER_POLL_INTERVAL_MS=150
WORKER_CONCURRENCY=16
WORKER_BATCH_SIZE=25
WORKER_LEASE_MS=30000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=2000
RETRY_JITTER_RATIO=0.15
REQUEST_TIMEOUT_MS=15000

# Per-Domain Egress Token Bucket
DOMAIN_BUCKET_CAPACITY=5
DOMAIN_BUCKET_REFILL_PER_SEC=2.0
DOMAIN_MAX_INFLIGHT=3

# Ingress / Mock Receiver Sliding Window Rate Limit
INGRESS_WINDOW_MS=10000
INGRESS_MAX_REQUESTS=200
MOCK_WINDOW_MS=10000
MOCK_MAX_REQUESTS=30

# Per-Domain Circuit Breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=15000

# Webhook Signing & Security
SIGNING_SECRET=pulsehook_dev_signing_secret_change_in_prod
ALLOW_PRIVATE_URLS=true
